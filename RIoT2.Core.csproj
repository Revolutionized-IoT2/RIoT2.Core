<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Compatibility facade: references every RIoT2.Core package and forwards the types that moved there (plan M1), so existing plugins and services keep working. Removed in Core 2.0.</Description>
    <!-- The facade's own sources are Facade/; the packages are under src/, the test kit under
         Testing/ and the services' hosting under Hosting/. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Facade/**/*.cs" />
    <None Remove=".gitignore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Contracts\RIoT2.Core.Contracts.csproj" />
    <ProjectReference Include="src\Mqtt\RIoT2.Core.Mqtt.csproj" />
    <ProjectReference Include="src\Http\RIoT2.Core.Http.csproj" />
    <ProjectReference Include="src\Devices\RIoT2.Core.Devices.csproj" />
    <ProjectReference Include="src\Node\RIoT2.Core.Node.csproj" />
  </ItemGroup>

</Project>
