<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The node loads plugins into their own AssemblyLoadContext. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- "name" in PluginManifest.json; the zip is Contoso.Riot2Plugin_<version>.zip. -->
    <RIoT2PluginName>Contoso devices</RIoT2PluginName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <InternalsVisibleTo Include="Contoso.Riot2Plugin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plugin SDK: PluginBase, AsyncDeviceBase, the device interfaces and typed options. -->
    <PackageReference Include="RIoT2.Core.Devices" />
    <!-- dotnet publish also writes bin/plugin/<zip>, PluginManifest.json inside it and the .sha256 sidecar. -->
    <PackageReference Include="RIoT2.Core.Devices.Build" PrivateAssets="all" />
  </ItemGroup>

</Project>
