<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>RIoT2.Core</RootNamespace>
    <!-- RIoT2JsonEncoder overrides TextEncoder's pointer-based members. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>RIoT2 wire contract: models, topics, enums, the message interfaces and the System.Text.Json setup (RIoT2JsonOptions, Json).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
