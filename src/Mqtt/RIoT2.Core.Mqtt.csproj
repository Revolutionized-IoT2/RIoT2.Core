<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>RIoT2.Core</RootNamespace>
    <Description>RIoT2 service runtime: the MQTT client (MqttClient), log scopes and the settings every service reads (SettingsReader, MqttOptions, LoggingOptions, TelemetryOptions).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\RIoT2.Core.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="MQTTnet" />
    <PackageReference Include="MQTTnet.Extensions.ManagedClient" />
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>

</Project>
