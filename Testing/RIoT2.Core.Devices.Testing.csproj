<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Released from the RIoT2.Core tag with the same version; the project reference becomes a
         package dependency on that RIoT2.Core version. -->
    <Version>1.5.0</Version>
    <DebugType>embedded</DebugType>
    <Description>Test kit for RIoT2 device plugins: PluginTestHost and PluginConformance.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RIoT2.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
