<Project>
  <!-- Every package in this repository is released from one tag with one version (plan M1 step 2).
       Keep it at or above the version consumers pin: RIoT2.Tests references these projects and the
       Orchestrator package at once, and NuGet picks the higher version. -->
  <PropertyGroup>
    <Version>1.18.0</Version>
    <!-- GitHub Packages has no symbol server: ship the PDB inside the DLL for SourceLink. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
